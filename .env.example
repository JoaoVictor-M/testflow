# ==========================================
# TESTFLOW CONFIGURAÇÃO DE AMBIENTE (.env)
# ==========================================
# Este arquivo define varíaveis globais que o Docker Compose utilizará
# Copie este arquivo e renomeie para ".env" na hora de subir o sistema.

# [ FRONTEND_URL ]
# Define o endereço base do sistema.
# O Backend usa isso para gerar links nos E-mails (como recuperação de senha).

# Exemplo de uso em máquina local (Desenvolvimento)
# FRONTEND_URL=https://localhost/testflow

# Exemplo de uso em Servidor Linux Físico com Domínio (Produção)
#FRONTEND_URL=https://testflow/testflow

# Exemplo de uso em Servidor Linux Acesso via IP (Produção Sem Domínio)
# FRONTEND_URL=https://192.168.0.1/testflow

# [ NGINX_PUBLIC_ORIGIN ]
# Origem HTTPS confiável para os redirecionamentos (sem caminho ou barra final).
# Opcional quando FRONTEND_URL contém uma única URL HTTPS: a origem é derivada automaticamente.
# Obrigatória quando FRONTEND_URL contém várias URLs separadas por vírgula ou usa HTTP.
# Se definida, tem prioridade sobre FRONTEND_URL. Hostname válido; porta opcional de 1 a 65535.
# NGINX_PUBLIC_ORIGIN=https://testflow.example.com
# NGINX_PUBLIC_ORIGIN=https://testflow.example.com:8443
# Sem FRONTEND_URL nem NGINX_PUBLIC_ORIGIN: https://localhost.
# HTTPS requer certificados/*.crt e *.key legíveis pelo GID 101 (root:101, modo 640).
# Consulte a migração de permissões TLS na seção de produção do README.
