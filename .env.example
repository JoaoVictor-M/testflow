# ==========================================
# TESTFLOW CONFIGURAÇÃO DE AMBIENTE (.env)
# ==========================================
# Este arquivo define varíaveis globais que o Docker Compose utilizará
# Copie este arquivo e renomeie para ".env" na hora de subir o sistema.

# [ FRONTEND_URL ]
# Define o endereço base do sistema.
# O Backend usa isso para gerar links nos E-mails (como recuperação de senha).

# Exemplo de uso em máquina local (Desenvolvimento)
# FRONTEND_URL=https://localhost/testflow

# Exemplo de uso em Servidor Linux Físico com Domínio (Produção)
#FRONTEND_URL=https://testflow/testflow

# Exemplo de uso em Servidor Linux Acesso via IP (Produção Sem Domínio)
# FRONTEND_URL=https://192.168.0.1/testflow

# [ NGINX_PUBLIC_ORIGIN ]
# Origem HTTPS confiável para os redirecionamentos (sem caminho ou barra final).
# Opcional quando FRONTEND_URL contém uma única URL HTTPS: a origem é derivada automaticamente.
# Obrigatória quando FRONTEND_URL contém várias URLs separadas por vírgula ou usa HTTP.
# Se definida, tem prioridade sobre FRONTEND_URL. Hostname válido; porta opcional de 1 a 65535.
# NGINX_PUBLIC_ORIGIN=https://testflow.example.com
# NGINX_PUBLIC_ORIGIN=https://testflow.example.com:8443
# Sem FRONTEND_URL nem NGINX_PUBLIC_ORIGIN: https://localhost.
# HTTPS requer certificados/*.crt e *.key legíveis pelo GID 101 (root:101, modo 640).
# Consulte a migração de permissões TLS na seção de produção do README.

# [ TESTFLOW_ADMIN_PASSWORD_HASH ]
# Hash bcrypt da senha do usuário `admin`, criado só na primeira subida (volume mongo-data novo).
# Sem esta variável nenhum usuário é criado; o log do MongoDB explica. Instalação existente não muda.
# Como gerar o hash: seção "Primeiro administrador" do README. Use aspas simples, por causa dos `$`.
# TESTFLOW_ADMIN_PASSWORD_HASH='$2b$10$substitua-pelo-hash-gerado'

# [ JWT_SECRET ]
# Chave secreta usada pelo backend para assinar e verificar tokens JWT (obrigatória; mínimo de 32 bytes).
# Sem uma chave válida o backend recusa iniciar. Gere uma chave forte com:
#   openssl rand -hex 32
# Ao migrar uma instalação existente ou rotacionar a chave, todas as sessões ativas são
# invalidadas imediatamente e os usuários precisarão fazer login novamente.
# JWT_SECRET=substitua-por-uma-chave-aleatoria-com-pelo-menos-32-bytes

# [ BACKUP_AGE_RECIPIENT ]
# Chave PÚBLICA do age (age1...) que criptografa o backup do Mongo e das evidências.
# Gere o par em outra máquina com `age-keygen -o age-identity.txt` e guarde a chave privada
# (age-identity.txt) fora do servidor e do Git: só ela abre o backup. Aqui entra apenas a pública.
# Backup: docker compose --profile tools run --rm backup  (grava em ./backups, ou em BACKUP_DIR)
# A pasta precisa ser gravável pelo UID 1000, e o arquivo sai com modo 0600 desse UID.
# Restauração: scripts/restore.sh
# BACKUP_AGE_RECIPIENT=age1substitua-pela-chave-publica
